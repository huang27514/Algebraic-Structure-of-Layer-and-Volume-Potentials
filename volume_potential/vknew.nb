               RowBox[{
                RowBox[{"vals", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "I"}], " ", 
                  RowBox[{"(", 
                   RowBox[{"k", "-", "1"}], ")"}], " ", 
                  RowBox[{"thetaList", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "1", ",", "Ncircle"}], "}"}]}], "]"}], 
             "]"}], "/", 
            RowBox[{"rCircle", "^", 
             RowBox[{"(", 
              RowBox[{"k", "-", "1"}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "Kmax"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"N", "[", 
         RowBox[{"coeffs", ",", "workPrec"}], "]"}]}]}], "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
