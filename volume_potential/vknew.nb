 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kappaOne", "[", 
     RowBox[{
      RowBox[{"m_Integer", "?", "NonNegative"}], ",", 
      RowBox[{"n_Integer", "?", "NonNegative"}], ",", 
      RowBox[{"ww_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"kappaOne", "[", 
      RowBox[{"m", ",", "n", ",", "ww"}], "]"}], "=", 
     RowBox[{"Quiet", "@", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"sc", "[", "x", "]"}], "^", "m"}], " ", 
         RowBox[{
          RowBox[{"x", "^", "n"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"zC", "[", "x", "]"}], "-", "ww"}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"WorkingPrecision", "->", "workPrec"}], ",", 
        RowBox[{"AccuracyGoal", "->", "accGoal"}], ",", 
        RowBox[{"PrecisionGoal", "->", "precGoal"}], ",", 
        RowBox[{"MaxRecursion", "->", "220"}], ",", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
           RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
       "]"}]}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
