 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getCenterData", "[", "q_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"getCenterData", "[", "q", "]"}], "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "wv", ",", "xx", ",", "yy", ",", "curve", ",", "dist", ",", "depth", 
         ",", "w0", ",", "minDist", ",", "ratio", ",", "rCircle"}], "}"}], 
       ",", 
       RowBox[{
        RowBox[{"wv", "=", 
         RowBox[{"evalPoints", "[", 
          RowBox[{"[", "q", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"xx", "=", 
         RowBox[{"Re", "[", "wv", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"yy", "=", 
         RowBox[{"Im", "[", "wv", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"curve", "=", 
         RowBox[{"sc", "[", "xx", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dist", "=", 
         RowBox[{"curve", "-", "yy"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"depth", "=", 
         RowBox[{"betaDepth", " ", "dist"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"w0", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"xx", "+", 
            RowBox[{"I", " ", 
             RowBox[{"(", 
              RowBox[{"curve", "-", "depth"}], ")"}]}]}], ",", "workPrec"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"minDist", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{
           RowBox[{"NMinimize", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"zC", "[", "t", "]"}], "-", "w0"}], "]"}], ",", 
               RowBox[{
                RowBox[{"-", "1"}], "<=", "t", "<=", "1"}]}], "}"}], ",", "t",
              ",", 
             RowBox[{"WorkingPrecision", "->", "60"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ratio", "=", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"wv", "-", "w0"}], "]"}], "/", "minDist"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rCircle", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"circleRadiusFactor", " ", "minDist"}], ",", "workPrec"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<w0\>\"", "->", "w0"}], ",", 
          RowBox[{"\"\<minDist\>\"", "->", "minDist"}], ",", 
          RowBox[{"\"\<ratio\>\"", "->", "ratio"}], ",", 
          RowBox[{"\"\<rCircle\>\"", "->", "rCircle"}], ",", 
          RowBox[{"\"\<dist\>\"", "->", "dist"}], ",", 
          RowBox[{"\"\<depth\>\"", "->", "depth"}]}], "|>"}]}]}], "]"}]}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
