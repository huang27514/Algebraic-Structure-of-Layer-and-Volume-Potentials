        RowBox[{"rCircle", "=", 
         RowBox[{"cd", "[", "\"\<rCircle\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"thetaList", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{"Ncircle", "-", "1"}]}], "]"}], "/", "Ncircle"}]}], 
           ",", "workPrec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"circlePts", "=", 
         RowBox[{"w0", "+", 
          RowBox[{"rCircle", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "thetaList"}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vals", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"kappaOne", "[", 
            RowBox[{"m", ",", "n", ",", 
             RowBox[{"circlePts", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "Ncircle"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"coeffs", "=", 
         RowBox[{"Table", "[", 
