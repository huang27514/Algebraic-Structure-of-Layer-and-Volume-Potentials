             RowBox[{"N", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"Re", "[", "approxC", "]"}], "-", 
                RowBox[{"Re", "[", "directC", "]"}]}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"complexErrMat", "[", 
              RowBox[{"[", 
               RowBox[{"kk", ",", "q"}], "]"}], "]"}], "=", 
