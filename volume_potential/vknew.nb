        RowBox[{"cd", "[", "\"\<ratio\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"directC", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"volDirectComplex", "[", "wv", "]"}], ",", "$Failed"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"NumericQ", "[", "directC", "]"}], ",", 
        RowBox[{
         RowBox[{"directRealVec", "[", 
          RowBox[{"[", "q", "]"}], "]"}], "=", 
         RowBox[{"N", "[", 
          RowBox[{"Re", "[", "directC", "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"directRealVec", "[", 
          RowBox[{"[", "q", "]"}], "]"}], "=", "Indeterminate"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"K", "=", 
          RowBox[{"KList", "[", 
           RowBox[{"[", "kk", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"approxC", "=", 
          RowBox[{"Quiet", "@", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"volApproxGlobalRecK", "[", 
              RowBox[{"wv", ",", "q", ",", "K"}], "]"}], ",", "$Failed"}], 
            "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
