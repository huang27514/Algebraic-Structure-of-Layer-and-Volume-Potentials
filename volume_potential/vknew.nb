     RowBox[{"kappaCoeffList", "[", 
      RowBox[{"q", ",", "m", ",", "n"}], "]"}], "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
